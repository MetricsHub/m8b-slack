# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_API_URL=https://slack.com/api

# ============================================================================
# System prompt: deployment notes (optional, append-only)
# ============================================================================
# The bot's persona, safety rules and tool guidance ship with the code and are
# the same for every organization; the organization name is read from the Slack
# workspace at startup (team.info with the "team:read" bot scope, else the team
# name from auth.test). Administrators can APPEND context the model should know
# about this deployment (teams and who handles what, host naming conventions,
# sites, local habits) — never replace or relax the built-in rules. The text is
# added as a delimited "Deployment notes" section at the end of the prompt.
# A Markdown/text file (relative paths resolve against the working directory;
# an unreadable file prevents the bot from starting):
# M8B_PROMPT_EXTRA_FILE=/etc/m8b-slack/deployment-notes.md
# and/or inline text (appended after the file's content):
# M8B_PROMPT_EXTRA="Storage alerts go to #storage-ops. Hosts are named <site>-<role>-<nn>."

# ============================================================================
# AI Provider Selection
# ============================================================================
# "openai" (default, hosted), "ollama" (local, OpenAI-compatible /v1/responses),
# "vllm" (local, OpenAI-compatible /v1/responses, native multimodal vision), or
# "openai-compatible" (any other endpoint serving the OpenAI /v1/responses API:
# corporate inference proxy, NVIDIA NIM, LiteLLM gateway, ...)
AI_PROVIDER=openai

# --- OpenAI mode -----------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI Vector Store (for knowledge base)
# Multiple stores (comma-separated):
# OPENAI_VECTOR_STORE_IDS=vs_abc123,vs_def456
# Single store:
# OPENAI_VECTOR_STORE_ID=vs_abc123

# Code Interpreter Container ID (optional)
# OPENAI_CODE_CONTAINER_ID=cc_...

# --- Self-hosted modes: common variables (ollama / vllm / openai-compatible) --
# Uncomment when AI_PROVIDER is not "openai". OPENAI_API_KEY is then not required
# and nothing is ever sent to OpenAI. All three presets read the SAME variables;
# AI_PROVIDER only fixes the defaults and the backend quirks listed further down.
# (The former OLLAMA_* / VLLM_* names of these settings still work as deprecated
# aliases and take precedence; the bot lists them at startup.)
#
# Endpoint (default: Ollama http://localhost:11434/v1, vLLM/generic http://localhost:8000/v1)
# AI_BASE_URL=http://dev-nvidia-01:11434/v1
# Bearer token expected by the endpoint. The OpenAI SDK requires one even when
# the server ignores it (defaults: "ollama", "vllm", "none")
# AI_API_KEY=...
# Model to use. Ollama default qwen3.8:27b. vLLM and openai-compatible adopt the
# served model when unset and the endpoint serves exactly ONE; with several (a
# gateway) it is required and the bot never guesses (it must appear in GET
# /v1/models when that endpoint is available; without a model the bot refuses
# to start).
# AI_MODEL=qwen3.8:27b
# The model's context window in tokens. Detected when the server reports it
# (Ollama native API; vLLM max_model_len; context_length on some gateways),
# otherwise the bot runs on a 32k default and warns at startup. A smaller
# explicit value is kept (tighter budget), a larger one is capped to a reported
# server value. This tells the BOT what the server allocates; it does not
# configure the server.
# AI_CONTEXT_LENGTH=32768
# AI_MAX_OUTPUT_TOKENS=4000
# AI_REQUEST_TIMEOUT_MS=300000
# Inline cap (chars) for a single tool result before truncation. Default scales
# with the context window (~40% of the usable budget).
# AI_MAX_TOOL_OUTPUT_CHARS=
#
# Knowledge-base embeddings (OpenAI-compatible /v1/embeddings). Unset model =
# local knowledge base disabled (neither search nor writes are offered); Ollama
# defaults it to nomic-embed-text (pull it: ollama pull nomic-embed-text; for
# bilingual corpora bge-m3 usually retrieves better). Rebuild the index
# (npm run kb:index) after changing the model, prefixes or input types.
# AI_EMBEDDING_MODEL=nomic-embed-text
# Embedding endpoint/key: default to AI_BASE_URL / AI_API_KEY. vLLM serves ONE
# model per instance, so in vLLM mode AI_EMBEDDING_BASE_URL is REQUIRED and must
# point to a dedicated endpoint (second vLLM instance or an Ollama server).
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=
# Task prefixes are applied automatically per model (nomic: search_query /
# search_document; mxbai: query instruction). Override only if your model needs
# different ones (set both empty to send none):
# AI_EMBEDDING_QUERY_PREFIX=
# AI_EMBEDDING_DOCUMENT_PREFIX=
# Some embedding APIs need a per-request input_type ("query" when searching,
# "passage" when indexing): NVIDIA nv-embedqa / nv-embed models are detected
# from their name and get it automatically. Override for other models (set both
# empty to send none).
# AI_EMBEDDING_QUERY_INPUT_TYPE=
# AI_EMBEDDING_DOCUMENT_INPUT_TYPE=
# Probed once at startup (warning only); a failing embedding call at runtime
# makes the knowledge base report itself unavailable for that search.
#
# Local knowledge base data directory (docs + embedding index)
# KNOWLEDGE_BASE_DIR=data/knowledge

# --- Ollama preset (AI_PROVIDER=ollama) ----------------------------------------
# Same name as Ollama's own OLLAMA_CONTEXT_LENGTH so the identical line works on
# both sides (permanent alias of AI_CONTEXT_LENGTH); must match Ollama's num_ctx.
# OLLAMA_CONTEXT_LENGTH=32768
# Vision model for image/screenshot attachments (pull it: ollama pull qwen3-vl:8b-instruct-8k).
# Images are described as text via /v1/chat/completions (Ollama's /v1/responses has no
# image input) and the description is injected into the conversation. Leave unset to
# disable: attachments are then surfaced as "cannot analyze" notes.
# OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct-8k
# Cap on the description length; the vision model's (often small, e.g. 8k) context
# must hold the image tokens + prompt + this output.
# OLLAMA_VISION_MAX_OUTPUT_TOKENS=600

# --- vLLM preset (AI_PROVIDER=vllm) --------------------------------------------
# Quirks fixed by the preset: native image input, strict chat-template input
# conforming, single served model adopted when AI_MODEL is unset, /v1/models
# required. No vLLM-specific variables beyond the common AI_* ones.
#
# Media store: screenshots are downloaded from Slack once, saved locally, and
# referenced by URL in the conversation (never re-sent as base64). Serve
# M8B_MEDIA_DIR at M8B_MEDIA_BASE_URL with NGINX, IP-restricted to the vLLM
# host (see README). Unset M8B_MEDIA_BASE_URL = base64 fallback (dev only).
# Also used by openai-compatible mode when AI_IMAGE_INPUT=true.
# M8B_MEDIA_DIR=/var/lib/m8b/media
# M8B_MEDIA_BASE_URL=https://bm-linux-slack.internal.sentrysoftware.net/m8b-media
# Age-based cleanup of stored screenshots, swept at startup and every 6h
# M8B_MEDIA_RETENTION_DAYS=7
# M8B_MEDIA_MAX_FILE_BYTES=10485760

# --- OpenAI-compatible preset (AI_PROVIDER=openai-compatible) ------------------
# Any other endpoint serving the OpenAI /v1/responses API with streaming and
# function tools (/v1/chat/completions alone is not enough). Set AI_MODEL when
# the endpoint serves several models, and AI_CONTEXT_LENGTH explicitly (most
# gateways do not report it). vLLM works through this preset too: it is
# openai-compatible + AI_IMAGE_INPUT=true + AI_STRICT_INPUT=true.
# Model-dependent quirks are opt-in:
# The model reads images natively (input_image items). Off by default: image
# attachments are then surfaced as "cannot analyze" notes. When on, configure
# the media store (M8B_MEDIA_*) as in vLLM mode.
# AI_IMAGE_INPUT=false
# Conform requests for servers with a strict chat template: one leading system
# message only, no mid-conversation system messages, assistant history as
# plain strings (what vLLM + Qwen need). Enable if the server answers
# 400 "System message must be at the beginning" or rejects output_text content.
# AI_STRICT_INPUT=false

# --- Local Python sandbox (Ollama/vLLM/openai-compatible modes) ----------------
# App-side replacement for OpenAI's code_interpreter: a run_python function tool
# backed by Pyodide (Python in WebAssembly; no host filesystem, no network).
# Enabled by default in local modes; set to false to remove the tool entirely.
# CODE_SANDBOX_ENABLED=true
# Hard wall-clock limit per execution (the worker is killed past it). The first
# run importing a package (numpy, pandas, ...) also downloads it, once.
# CODE_SANDBOX_TIMEOUT_MS=60000
# Where Pyodide caches downloaded Python packages across runs/restarts
# CODE_SANDBOX_PACKAGE_CACHE_DIR=node_modules/.cache/pyodide
# Total size cap for the files one execution may deliver to Slack
# CODE_SANDBOX_MAX_OUTPUT_FILE_BYTES=20971520
# Size cap for a single user attachment staged into /data for run_python analysis.
# Attachments are streamed to disk and mounted into the sandbox (not buffered in
# memory); Pyodide's ~2 GB WASM heap still bounds what Python can load at once.
# CODE_SANDBOX_MAX_INPUT_FILE_BYTES=104857600
# On-disk staging area: the persistent attachment download cache plus the
# per-execution /data directories mounted into the sandbox
# CODE_SANDBOX_STAGING_DIR=node_modules/.cache/m8b-staging
# Size the download cache may reach before least-recently-used files are evicted
# CODE_SANDBOX_STAGING_CACHE_MAX_BYTES=2147483648

# --- Web search (Ollama/vLLM/openai-compatible modes) --------------------------
# OpenAI's hosted web_search is unavailable locally. Configure one backend or
# leave unset to disable web search entirely (no silent fallback).
# WEB_SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://searxng.internal:8080
# Or, explicit opt-in to Ollama's hosted search (data leaves your network!):
# WEB_SEARCH_PROVIDER=ollama-cloud
# OLLAMA_CLOUD_API_KEY=...

# --- Page reader (Ollama/vLLM/openai-compatible modes) --------------------------
# OpenAI's hosted web search reads pages by itself; locally, a fetch_url function
# tool reads the URLs users paste: the site's Markdown rendition first (Accept
# negotiation, sibling .md, /llms.txt), GitHub issues and pull requests through
# the REST API, and otherwise the HTML page reduced to text.
# Enabled by default; set to false to remove the tool entirely.
# FETCH_URL_ENABLED=true
# Scope which sites may be read: comma-separated host suffixes (example.com also
# matches docs.example.com). Blocked wins; an empty allow list allows every
# public host. Private, loopback, link-local and cloud-metadata addresses are
# always refused, redirects included.
# FETCH_URL_ALLOWED_HOSTS=
# FETCH_URL_BLOCKED_HOSTS=
# Per-request timeout and response size cap (bytes)
# FETCH_URL_TIMEOUT_MS=20000
# FETCH_URL_MAX_BYTES=2097152
# Optional GitHub token: private repositories and a higher API rate limit.
# Sent to api.github.com only, never to any other host (dropped on redirects).
# The token is the BOT's: every Slack user who can talk to the bot reads
# through it. Scope it to the repositories they may all see
# ("owner/repo" or "owner/*", comma-separated); empty = every repository.
# GITHUB_TOKEN=
# GITHUB_TOKEN_REPOS=

# Maximum model->tools->model iterations per Slack message (default 15)
# AI_MAX_AGENT_ITERATIONS=15

# ============================================================================
# MetricsHub MCP Server (single server mode)
# ============================================================================
# For multiple servers, use ai/mcp.config.local.js instead
# MCP_AGENT_URL=https://metricshub.example.com/sse
# MCP_AGENT_TOKEN=your-mcp-token

# MetricsHub configuration editing (REST API on the same origin/token as MCP).
# Slack user IDs allowed to request configuration changes through the bot
# (file edits, credential requests). Comma-separated. EMPTY = editing disabled.
# METRICSHUB_CONFIG_ADMINS=U01234ABCDE,U0567FGHIJK
# How long a credential dialog or change-approval button stays valid (default 15 min)
# METRICSHUB_INTERACTION_TIMEOUT_MS=900000
# Periodic refresh of the consolidated host map (ListHosts/SearchHost).
# Also refreshed automatically after every config change. Default 1 hour; 0 disables.
# MCP_HOSTS_REFRESH_INTERVAL_MS=3600000

# Prometheus (optional)
# M8B_PROMETHEUS_URL=http://prometheus.example.com:9090

# Environment
# Controls logging level:
#  - production: WARN only
#  - test: INFO and above
#  - debug/development: DEBUG and above (verbose)
NODE_ENV=test
